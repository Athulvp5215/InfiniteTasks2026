 @model InsuranceManagementSystem.Models.User

@{
    ViewBag.Title = "Delete User";
}

<div class="container mt-5">

    
    <div class="text-center mb-4">
        <h2 class="fw-bold text-danger">Delete User</h2>
        <p class="text-muted">Confirm before deleting this user</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

              
                <div class="alert alert-danger text-center">
                    <strong>Warning!</strong> Are you sure you want to delete this user?
                </div>

                
                <table class="table table-bordered">

                    <tr>
                        <th>User ID</th>
                        <td>@Model.UserId</td>
                    </tr>

                    <tr>
                        <th>Full Name</th>
                        <td class="fw-semibold">@Model.FullName</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>

                    <tr>
                        <th>Phone Number</th>
                        <td>@Model.PhoneNumber</td>
                    </tr>

                    <tr>
                        <th>Role</th
                        <td>
                            <span class="badge bg-info text-dark">
                                @Model.Role
                            </span>
                        </td>
                    </tr>

                </table>

              
                @using (Html.BeginForm())
                {
                    @Html.HiddenFor(m => m.UserId)

                    <div class="d-grid gap-2 mt-3">

                        <input type="submit"
                               value="Delete"
                               class="btn btn-danger"
                               onclick="return confirm('Are you sure you want to delete this user?');" />

                        @Html.ActionLink(
                                 "Cancel",
                                 "Index",
                                 null,
                                 new { @class = "btn btn-secondary text-center" }
                             )

                    </div>
                }

            </div>

        </div>
    </div>

</div>


