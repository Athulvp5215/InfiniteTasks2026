@model InsuranceManagementSystem.Models.User

@{
    ViewBag.Title = "User Details";
}

<div class="container mt-5">

    
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">User Details</h2>
        <p class="text-muted">View complete user information</p>
    </div>

  
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

                 <table class="table table-bordered">

                    <tr>
                        <th>User ID</th>
                        <td>@Model.UserId</td>
                    </tr>

                    <tr>
                        <th>Full Name</th>
                        <td class="fw-semibold">@Model.FullName</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>

                    <tr>
                        <th>Phone Number</th>
                        <td>@Model.PhoneNumber</td>
                    </tr>

                    <tr>
                        <th>Role</th>
                        <td>
                            <span class="badge bg-info text-dark">
                                @Model.Role
                            </span>
                        </td>
                    </tr>

                </table>

             
                <div class="text-center mt-3">

                    @Html.ActionLink(
                             "Edit",
                             "Edit",
                             new { id = Model.UserId },
                             new { @class = "btn btn-primary me-2 px-4" }
                         )

                    @Html.ActionLink(
                             "Back to List",
                             "Index",
                             null,
                             new { @class = "btn btn-secondary px-4" }
                         )

                </div>

            </div>

        </div>
    </div>

</div>
