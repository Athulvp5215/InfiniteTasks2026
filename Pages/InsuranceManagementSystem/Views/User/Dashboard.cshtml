@{
    ViewBag.Title = "User Dashboard";
}

<div class="container mt-4">

    <div class="mb-4 text-center">
        <h2 class="fw-bold text-primary">User Dashboard</h2>
        <h5 class="text-muted">Welcome @Session["UserName"]</h5>
    </div>

    <hr />


    <div class="row g-4">
    <div class="row g-4">

      
        <div class="col-md-3">
            <div class="card shadow rounded-4 text-center p-3 bg-primary text-white">
                <h5>My Policies</h5>
                <div class="mt-3">
                    @Html.ActionLink(
                             "Open",
                             "Index",
                             "Policy",
                             null,
                             new { @class = "btn btn-light btn-sm" }
                         )
                </div>
            </div>
        </div>

  
        <div class="col-md-3">
            <div class="card shadow rounded-4 text-center p-3 bg-success text-white">
                <h5>Claims</h5>
                <div class="mt-3">
                    @Html.ActionLink(
                             "Open",
                             "Index",
                             "Claim",
                             null,
                             new { @class = "btn btn-light btn-sm" }
                         )
                </div>
            </div>
        </div>

   
        <div class="col-md-3">
            <div class="card shadow rounded-4 text-center p-3 bg-warning text-dark">
                <h5>Payments</h5>
                <div class="mt-3">
                    @Html.ActionLink(
                             "Open",
                             "Index",
                             "Payment",
                             null,
                             new { @class = "btn btn-dark btn-sm" }
                         )
                </div>
            </div>
        </div>

        
        <div class="col-md-3">
            <div class="card shadow rounded-4 text-center p-3 bg-danger text-white">
                <h5>Account</h5>
                <div class="mt-3">
                    @Html.ActionLink(
                             "Logout",
                             "Logout",
                             "Account",
                             null,
                             new { @class = "btn btn-light btn-sm" }
                         )
                </div>
            </div>
        </div>

    </div>

</div>
