@model InsuranceManagementSystem.Models.User

@{
    ViewBag.Title = "User Registration";
}

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">User Registration</h2>
        <p class="text-muted">Create your account to access insurance services</p>
    </div>

    <!-- Card -->
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    <!-- Name -->
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        @Html.TextBoxFor(m => m.FullName,
                            new { @class = "form-control", placeholder = "Enter your name" })
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.Email,
                            new { @class = "form-control", placeholder = "Enter email" })
                    </div>

                    

                    <!-- Contact -->
                    <div class="mb-3">
                        <label class="form-label">Contact Number</label>
                        @Html.TextBoxFor(m => m.PhoneNumber,
                            new { @class = "form-control", placeholder = "Enter contact number" })
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        @Html.TextAreaFor(m => m.Address,
                            new { @class = "form-control", rows = 2, placeholder = "Enter your address" })
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        @Html.PasswordFor(m => m.Password,
                            new { @class = "form-control", placeholder = "Enter password" })
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm password" />
                    </div>

                    <!-- Submit -->
                    <div class="d-grid">
                        <input type="submit" value="Register" class="btn btn-primary" />
                    </div>
                }

                <!-- Link -->
                <div class="text-center mt-3">
                    <span class="small">Already have an account?</span>
                    @Html.ActionLink(" Login", "Login", "Account",
                        null, new { @class = "fw-bold small" })
                </div>

            </div>

        </div>
    </div>

</div>