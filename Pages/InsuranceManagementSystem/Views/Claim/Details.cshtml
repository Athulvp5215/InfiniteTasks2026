@model InsuranceManagementSystem.Models.Claim

@{
    ViewBag.Title = "Claim Details";
}

<div class="container mt-5">

 
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Claim Details</h2>
        <p class="text-muted">View complete claim information</p>
    </div>


    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

    
                <table class="table table-bordered">

                    <tr>
                        <th>Claim ID</th>
                        <td>@Model.ClaimId</td>
                    </tr>

                    <tr>
                        <th>Policy ID</th>
                        <td>@Model.PolicyId</td>
                    </tr>

                    <tr>
                        <th>Claim Amount</th>
                        <td class="text-success fw-bold">
                            ₹ @Model.ClaimAmount
                        </td>
                    </tr>

                    <tr>
                        <th>Claim Reason</th>
                        <td>@Model.ClaimReason</td>
                    </tr>

                    <tr>
                        <th>Status</th>
                        <td>
                            @if (Model.ClaimStatus == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (Model.ClaimStatus == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                    </tr>

                </table>

                <div class="text-center mt-3">
                    @Html.ActionLink(
                             "Back to List",
                             "Index",
                             null,
                             new { @class = "btn btn-secondary px-4" }
                         )
                </div>

            </div>

        </div>
    </div>

</div>

