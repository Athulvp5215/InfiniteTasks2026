@model InsuranceMan @model InsuranceManagementSystem.Models.Claim

@{
    ViewBag.Title = "Delete Claim";
}

<div class="container mt-5">

    
    <div class="text-center mb-4">
        <h2 class="fw-bold text-danger">Delete Claim</h2>
        <p class="text-muted">Please confirm before deleting this claim</p>
    </div>

   
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

              
                <div class="alert alert-danger text-center">
                    <strong>Warning!</strong> Are you sure you want to delete this claim?
                </div>

              
                <table class="table table-bordered">

                    <tr>
                        <th>Claim ID</th>
                        <td>@Model.ClaimId</td>
                    </tr>

                    <tr>
                        <th>Policy ID</th>
                        <td>@Model.PolicyId</td>
                    </tr>

                    <tr>
                        <th>Claim Amount</th>
                        <td class="text-success fw-bold">
                            ₹ @Model.ClaimAmount
                        </td>
                    </tr>

                    <tr>
                        <th>Claim Reason</th>
                        <td>@Model.ClaimReason</td>
                    </tr>

                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge bg-warning text-dark">
                                @Model.ClaimStatus
                            </span>
                        </td>
                    </tr>

                </table>

              
                @using (Html.BeginForm())
                {
                    @Html.HiddenFor(m => m.ClaimId)

                    <div class="d-grid gap-2 mt-3">

                      
                        <input type="submit"
                               value="Delete"
                               class="btn btn-danger"
                               onclick="return confirm('Are you sure you want to delete this claim?');" />

                   
                        @Html.ActionLink(
                                 "Cancel",
                                 "Index",
                                 null,
                                 new { @class = "btn btn-secondary text-center" }
                             )

                    </div>
                }

            </div>

        </div>
    </div>

</div>

