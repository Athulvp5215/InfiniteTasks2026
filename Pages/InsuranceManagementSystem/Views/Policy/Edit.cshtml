@model InsuranceManagementSystem.Models.Policy

@{
    ViewBag.Title = "Edit Policy";
}

<div class="container mt-5">


    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Edit Policy</h2>
        <p class="text-muted">Update policy details</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow rounded-4 p-4">

                @using (Html.BeginForm())
                {
                    @Html.HiddenFor(m => m.PolicyId)

                    <div class="mb-3">
                        <label class="form-label">Policy Number</label>
                        @Html.TextBoxFor(m => m.PolicyNumber,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Enter policy number"
                                 })
                    </div>

                   
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        @Html.DropDownList(
                                 "UserId",
                                 null,
                                 "Select User",
                                 new { @class = "form-select" }
                             )
                    </div>

                  
                    <div class="mb-3">
                        <label class="form-label">Select Plan</label>
                        @Html.DropDownList(
                                 "PlanId",
                                 null,
                                 "Select Plan",
                                 new { @class = "form-select" }
                             )
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Premium Amount (₹)</label>
                        @Html.TextBoxFor(m => m.PremiumAmount,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Enter amount"
                                 })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        @Html.TextBoxFor(m => m.StartDate,
                                 "{0:yyyy-MM-dd}",
                                 new
                                 {
                                     @class = "form-control",
                                     type = "date"
                                 })
                    </div>

           
                    <div class="mb-4">
                        <label class="form-label">End Date</label>
                        @Html.TextBoxFor(m => m.EndDate,
                                 "{0:yyyy-MM-dd}",
                                 new
                                 {
                                     @class = "form-control",
                                     type = "date"
                                 })
                    </div>

                    <div class="d-grid gap-2">

                        <input type="submit"
                               value="Update Policy"
                               class="btn btn-primary" />

                        @Html.ActionLink(
                                 "Cancel",
                                 "Index",
                                 null,
                                 new { @class = "btn btn-secondary text-center" }
                             )

                    </div>
                }

            </div>

        </div>
    </div>

</div>
