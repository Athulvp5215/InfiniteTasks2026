@model IEnumerable<InsuranceManagementSystem.Models.Policy>

@{
    ViewBag.Title = "Policies";
}

<div class="container mt-4">

 
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-primary">Policies</h2>
            <p class="text-muted">Manage all insurance policies</p>
        </div>

      
        @Html.ActionLink(
                 "Create Policy",
                 "Create",
                 null,
                 new { @class = "btn btn-success px-4" }
             )
    </div>


    <div class="card shadow rounded-4">

        <div class="card-body">

            <table class="table table-hover table-striped text-center align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Policy Number</th>
                        <th>Premium (₹)</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                      
                            <td class="fw-semibold text-primary">
                                @item.PolicyNumber
                            </td>

                   
                            <td class="text-success fw-bold">
                                ₹ @item.PremiumAmount
                            </td>

                            <td>
                                @(item.StartDate?.ToString("dd-MM-yyyy"))
                            </td>

                            <td>
                                @(item.EndDate?.ToString("dd-MM-yyyy"))
                            </td>

                         
                            <td>
                                @Html.ActionLink(
                                         "Details",
                                         "Details",
                                         new { id = item.PolicyId },
                                         new { @class = "btn btn-sm btn-info text-white me-1" }
                                     )

                                @Html.ActionLink(
                                         "Edit",
                                         "Edit",
                                         new { id = item.PolicyId },
                                         new { @class = "btn btn-sm btn-warning text-dark me-1" }
                                     )

                                @Html.ActionLink(
                                         "Delete",
                                         "Delete",
                                         new { id = item.PolicyId },
                                         new
                                         {
                                             @class = "btn btn-sm btn-danger",
                                             onclick = "return confirm('Are you sure you want to delete this policy?');"
                                         }
                                     )
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>