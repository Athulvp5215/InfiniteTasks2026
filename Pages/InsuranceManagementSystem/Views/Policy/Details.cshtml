@model InsuranceManagementSystem.Models.Policy

@{
    ViewBag.Title = "Policy Details";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Policy Details</h2>
        <p class="text-muted">View complete policy information</p>
    </div>


    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

             
                <div class="mb-3">
                    <p>
                        <b>Policy Number:</b><br />
                        <span class="text-primary">@Model.PolicyNumber</span>
                    </p>

                    <p>
                        <b>Premium Amount:</b><br />
                        <span class="text-success fw-bold">
                            ₹ @Model.PremiumAmount
                        </span>
                    </p>

                    <p>
                        <b>Start Date:</b><br />
                        @Model.StartDate.ToString("dd-MM-yyyy")
                    </p>

                    <p>
                        <b>End Date:</b><br />
                        @Model.EndDate.ToString("dd-MM-yyyy")
                    </p>
                </div>

                <hr />

     
                <div class="text-center">
                    @Html.ActionLink(
                             "Back",
                             "Index",
                             null,
                             new { @class = "btn btn-secondary px-4" }
                         )
                </div>

            </div>

        </div>
    </div>

</div>
