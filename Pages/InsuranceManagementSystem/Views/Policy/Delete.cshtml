@model InsuranceManagementSystem.Models.Policy

@{
    ViewBag.Title = "Delete Policy";
}

<div class="container mt-5">


    <div class="text-center mb-4">
        <h2 class="fw-bold text-danger">Delete Policy</h2>
        <p class="text-muted">Please confirm before removing this policy</p>
    </div>

 
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

                <div class="alert alert-danger text-center">
                    <strong>Warning!</strong> Are you sure you want to delete this policy?
                </div>

     
                <p class="text-center">
                    Policy Number:
                    <br />
                    <strong class="text-primary">@Model.PolicyNumber</strong>
                </p>

            
                @using (Html.BeginForm())
                {
                    @Html.HiddenFor(m => m.PolicyId)

                    <div class="d-grid gap-2 mt-3">

           
                        <input type="submit"
                               value="Delete"
                               class="btn btn-danger"
                               onclick="return confirm('Are you sure you want to delete this policy?');" />

                        @Html.ActionLink(
                                 "Cancel",
                                 "Index",
                                 null,
                                 new { @class = "btn btn-secondary text-center" }
                             )

                    </div>
                }

            </div>

        </div>
    </div>

</div>
