@model InsuranceManagementSystem.Models.Policy

@{
    ViewBag.Title = "Create Policy";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Create Policy</h2>
        <p class="text-muted">Add a new insurance policy</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow rounded-4 p-4">

                @using (Html.BeginForm())
                {

                 
                    <div class="mb-3">
                        <label class="form-label">Policy Number</label>
                        @Html.TextBoxFor(m => m.PolicyNumber,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Enter policy number"
                                 })
                    </div>

               
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        @Html.DropDownList(
                                 "UserId",
                                 null,
                                 "Select User",
                                 new { @class = "form-select" }
                             )
                    </div>

   
                    <div class="mb-3">
                        <label class="form-label">Select Plan</label>
                        @Html.DropDownList(
                                 "PlanId",
                                 null,
                                 "Select Plan",
                                 new { @class = "form-select" }
                             )
                    </div>

                  
                    <div class="mb-3">
                        <label class="form-label">Premium Amount (₹)</label>
                        @Html.TextBoxFor(m => m.PremiumAmount,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Enter premium amount"
                                 })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        @Html.TextBoxFor(m => m.StartDate,
                                 "{0:yyyy-MM-dd}",
                                 new
                                 {
                                     @class = "form-control",
                                     type = "date"
                                 })
                    </div>

  
                    <div class="mb-4">
                        <label class="form-label">End Date</label>
                        @Html.TextBoxFor(m => m.EndDate,
                                 "{0:yyyy-MM-dd}",
                                 new
                                 {
                                     @class = "form-control",
                                     type = "date"
                                 })
                    </div>


                    <div class="d-grid">
                        <input type="submit"
                               value="Save Policy"
                               class="btn btn-primary" />
                    </div>

                }

            </div>

        </div>
    </div>

</div>

