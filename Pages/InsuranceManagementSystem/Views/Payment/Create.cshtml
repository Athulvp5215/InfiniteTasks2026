@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Create Payment";
}

<div class="container mt-5">


    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Make Payment</h2>
        <p class="text-muted">Pay for your insurance policy</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

                @using (Html.BeginForm())
                {

                   
                    <div class="mb-3">
                        <label class="form-label">Select Policy</label>
                        @Html.DropDownList(
                                 "PolicyId",
                                 null,
                                 "Select Policy",
                                 new { @class = "form-select" }
                             )
                    </div>

                  
                    <div class="mb-3">
                        <label class="form-label">Amount (₹)</label>
                        @Html.TextBoxFor(m => m.Amount,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Enter payment amount"
                                 })
                    </div>

                   
                    <div class="d-grid mt-3">
                        <input type="submit"
                               value="Make Payment"
                               class="btn btn-success" />
                    </div>

                }

            </div>

        </div>
    </div>

</div>

