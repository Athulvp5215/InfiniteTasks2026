@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Delete Payment";
}

<h2>Delete Payment</h2>

<h3>
    Are you sure you want to delete this payment?
</h3>

<table border="1" cellpadding="10">
    <tr>
        <th>Payment ID</th>
        <td>@Model.PaymentId</td>
    </tr>

    <tr>
        <th>Policy ID</th>
        <td>@Model.PolicyId</td>
    </tr>
    @model InsuranceManagementSystem.Models.Payment

    @{
        ViewBag.Title = "Delete Payment";
    }

    <div class="container mt-5">

      
        <div class="text-center mb-4">
            <h2 class="fw-bold text-danger">Delete Payment</h2>
            <p class="text-muted">Confirm before deleting this payment</p>
        </div>

       
        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow rounded-4 p-4">

                    <div class="alert alert-danger text-center">
                        <strong>Warning!</strong> Are you sure you want to delete this payment?
                    </div>

                 
                    <table class="table table-bordered">

                        <tr>
                            <th>Payment ID</th>
                            <td>@Model.PaymentId</td>
                        </tr>

                        <tr>
                            <th>Policy ID</th>
                            <td>@Model.PolicyId</td>
                        </tr>

                        <tr>
                            <th>Amount</th>
                            <td class="fw-bold text-success">
                                ₹ @Model.Amount
                            </td>
                        </tr>

                    </table>

                  
                    @using (Html.BeginForm())
                    {
                        @Html.HiddenFor(m => m.PaymentId)

                        <div class="d-grid gap-2 mt-3">

                            <input type="submit"
                                   value="Delete"
                                   class="btn btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this payment?');" />

                          
                            @Html.ActionLink(
                                "Cancel",
                                "Index",
                                null,
                                new { @class = "btn btn-secondary text-center" }
                            )

                        </div>
                    }

                </div>

            </div>
        </div>

    </div>

