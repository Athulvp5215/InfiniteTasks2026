@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Payment Details";
}

<div class="container mt-5">

    
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Payment Details</h2>
        <p class="text-muted">View complete payment information</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow rounded-4 p-4">

              
                <table class="table table-bordered">

                    <tr>
                        <th>Payment ID</th>
                        <td>@Model.PaymentId</td>
                    </tr>

                    <tr>
                        <th>Policy ID</th>
                        <td>@Model.PolicyId</td>
                    </tr>

                    <tr>
                        <th>Amount</th>
                        <td class="fw-bold text-success">
                            ₹ @Model.Amount
                        </td>
                    </tr>

                </table>

                <div class="text-center mt-3">

                    @Html.ActionLink(
                             "Back to List",
                             "Index",
                             null,
                             new { @class = "btn btn-secondary px-4" }
                         )

                </div>

            </div>

        </div>
    </div>

</div>



