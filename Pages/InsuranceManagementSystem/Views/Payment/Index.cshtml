@model IEnumerable<InsuranceManagementSystem.Models.Payment>

@{
    ViewBag.Title = "Payments";
}

<div class="container mt-4">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-primary">Payments</h2>
            <p class="text-muted">Manage all payments</p>
        </div>

     
        @Html.ActionLink(
                 "Create Payment",
                 "Create",
                 null,
                 new { @class = "btn btn-success px-4" }
             )
    </div>

  
    <div class="card shadow rounded-4">

        <div class="card-body">

            <table class="table table-hover table-striped text-center">

                <thead class="table-dark">
                    <tr>
                        <th>Payment ID</th>
                        <th>Policy ID</th>
                        <th>Amount (₹)</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                          
                            <td>@item.PaymentId</td>

                           
                            <td>@item.PolicyId</td>

                          
                            <td class="fw-bold text-success">
                                ₹ @item.Amount
                            </td>

                          
                            <td>
                                @Html.ActionLink(
                                         "Details",
                                         "Details",
                                         new { id = item.PaymentId },
                                         new { @class = "btn btn-sm btn-info text-white me-2" }
                                     )

                                @Html.ActionLink(
                                         "Delete",
                                         "Delete",
                                         new { id = item.PaymentId },
                                         new
                                         {
                                             @class = "btn btn-sm btn-danger",
                                             onclick = "return confirm('Delete this payment?');"
                                         }
                                     )
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>
