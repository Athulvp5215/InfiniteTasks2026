<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>@ViewBag.Title - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #212529;
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
        }

            .sidebar h3 {
                color: white;
                text-align: center;
                padding: 20px;
                border-bottom: 1px solid #444;
                margin: 0;
                background: #0d6efd;
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 15px 20px;
                font-size: 16px;
                transition: 0.3s;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

                .sidebar a:hover {
                    background: #0d6efd;
                    padding-left: 30px;
                }

                .sidebar a i {
                    width: 25px;
                    margin-right: 10px;
                    text-align: center;
                }

        .content {
            margin-left: 260px;
            padding: 20px;
        }

        .navbar-box {
            background: white;
            padding: 15px 25px;
            border-radius: 10px;
            box-shadow: 0px 2px 8px lightgray;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .navbar-box h5 {
                margin: 0;
                font-weight: 600;
            }

        .dashboard-content {
            margin-top: 20px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 2px 8px lightgray;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            color: gray;
        }

        @@media(max-width:768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>

</head>
<body>

    <div class="sidebar">

        <h3>
            <i class="fa-solid fa-shield-halved"></i>
            Admin Panel
        </h3>

        <a href="@Url.Action("Dashboard","Admin")">
            <i class="fa-solid fa-gauge-high"></i>
            Dashboard
        </a>

        <a href="@Url.Action("Users","Admin")">
            <i class="fa-solid fa-users"></i>
            Users
        </a>

        <a href="@Url.Action("Vehicles","Admin")">
            <i class="fa-solid fa-car"></i>
            Vehicles
        </a>

        <a href="@Url.Action("Policies","Admin")">
            <i class="fa-solid fa-file-contract"></i>
            Policies
        </a>

        <a href="@Url.Action("Claims","Admin")">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Claims
        </a>

        <a href="@Url.Action("Payments","Admin")">
            <i class="fa-solid fa-credit-card"></i>
            Payments
        </a>

        <a href="@Url.Action("Renewals","Admin")">
            <i class="fa-solid fa-rotate-right"></i>
            Renewals
        </a>

        <a href="@Url.Action("Index","InsurancePlan")">
            <i class="fa-solid fa-shield"></i>
            Insurance Plans
        </a>

        <a href="@Url.Action("Logout","Account")">
            <i class="fa-solid fa-right-from-bracket"></i>
            Logout
        </a>

    </div>

    <div class="content">

        <div class="navbar-box">

            <h5>
                <i class="fa-solid fa-user-shield"></i>
                Welcome Admin :
                @Session["UserName"]
            </h5>

            <span class="badge bg-success">
                Administrator
            </span>

        </div>

        <br />

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="dashboard-content">

            @RenderBody()

        </div>

        <div class="footer">

            <hr />

            <p>
                © @DateTime.Now.Year Vehicle Insurance Management System
            </p>

        </div>

    </div>

</body>
</html>