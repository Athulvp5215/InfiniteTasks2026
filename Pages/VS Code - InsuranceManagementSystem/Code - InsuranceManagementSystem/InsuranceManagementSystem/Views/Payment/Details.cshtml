@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Payment Details";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<h2>Payment Details</h2>

<hr />

<table class="table table-bordered">

    <tr>
        <th>Payment ID</th>
        <td>@Model.PaymentId</td>
    </tr>

    <tr>
        <th>Policy Number</th>
        <td>@Model.Policy.PolicyNumber</td>
    </tr>

    <tr>
        <th>Amount</th>
        <td>₹ @Model.Amount</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.PaymentStatus</td>
    </tr>

    <tr>
        <th>Payment Date</th>
        <td>@Model.PaymentDate</td>
    </tr>

</table>

<a href="@Url.Action(
    "PaymentHistory",
    "Payment")"
   class="btn btn-secondary">
    Back
</a>