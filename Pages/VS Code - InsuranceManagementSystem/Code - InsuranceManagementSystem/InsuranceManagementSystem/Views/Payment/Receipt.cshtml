@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Payment Receipt";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="card">

    <div class="card-header bg-success text-white">
        <h3>Payment Receipt</h3>
    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <tr>
                <th>Receipt No</th>
                <td>RCPT-@Model.PaymentId</td>
            </tr>

            <tr>
                <th>Policy Number</th>
                <td>@Model.Policy.PolicyNumber</td>
            </tr>

            <tr>
                <th>Amount Paid</th>
                <td>₹ @Model.Amount</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>@Model.PaymentStatus</td>
            </tr>

            <tr>
                <th>Payment Date</th>
                <td>@Model.PaymentDate</td>
            </tr>

        </table>

        <a href="@Url.Action(
            "PaymentHistory",
            "Payment")"
           class="btn btn-primary">
            Back To Payments
        </a>

    </div>

</div>