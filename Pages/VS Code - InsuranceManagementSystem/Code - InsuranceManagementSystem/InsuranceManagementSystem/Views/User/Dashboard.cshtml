@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      rel="stylesheet" />

<style>

    .dashboard-title {
        margin-bottom: 25px;
        font-weight: bold;
        color: #1e293b;
    }

    .dashboard-card {
        border: none;
        border-radius: 15px;
        color: white;
        padding: 25px;
        transition: 0.3s;
        box-shadow: 0px 5px 15px rgba(0,0,0,.15);
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

        .dashboard-card i {
            font-size: 45px;
            opacity: 0.8;
        }

        .dashboard-card h2 {
            font-weight: bold;
            margin-top: 10px;
        }

        .dashboard-card p {
            margin: 0;
            font-size: 18px;
        }

    .policy-card {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .vehicle-card {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }

    .claim-card {
        background: linear-gradient(135deg,#f59e0b,#d97706);
    }

    .payment-card {
        background: linear-gradient(135deg,#dc2626,#b91c1c);
    }
</style>

<h2 class="dashboard-title">
    <i class="fa fa-gauge-high"></i>
    User Dashboard
</h2>

<div class="row g-4">

    <div class="col-md-3">

        <div class="dashboard-card policy-card">

            <i class="fa fa-file-contract"></i>

            <h2>@ViewBag.TotalPolicies</h2>

            <p>Total Policies</p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card vehicle-card">

            <i class="fa fa-car"></i>

            <h2>@ViewBag.TotalVehicles</h2>

            <p>Total Vehicles</p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card claim-card">

            <i class="fa fa-triangle-exclamation"></i>

            <h2>@ViewBag.TotalClaims</h2>

            <p>Total Claims</p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card payment-card">

            <i class="fa fa-credit-card"></i>

            <h2>@ViewBag.TotalPayments</h2>

            <p>Total Payments</p>

        </div>

    </div>

</div>

<hr class="mt-5" />

<div class="card shadow mt-4">

    <div class="card-body">

        <h4>
            Welcome, @Session["UserName"]
        </h4>

        <p class="text-muted">
            Manage your vehicles, insurance policies, claims,
            payments, and renewals from one place.
        </p>

    </div>

</div>