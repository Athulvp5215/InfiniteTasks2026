@model InsuranceManagementSystem.Models.User

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<h2>My Profile</h2>

<hr />

<table class="table table-bordered">

    <tr>
        <th>User ID</th>
        <td>@Model.UserId</td>
    </tr>

    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Phone Number</th>
        <td>@Model.PhoneNumber</td>
    </tr>

    <tr>
        <th>Address</th>
        <td>@Model.Address</td>
    </tr>

</table>

<a href="@Url.Action("EditProfile","User")"
   class="btn btn-warning">
    Edit Profile
</a>