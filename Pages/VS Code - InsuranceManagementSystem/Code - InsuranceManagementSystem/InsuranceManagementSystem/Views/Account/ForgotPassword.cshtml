@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f5f5;
        }

        .box {
            width: 450px;
            margin: 80px auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0px 0px 15px lightgray;
        }
    </style>
</head>
<body>

    <div class="box">

        <h2 class="text-center">
            Reset Password
        </h2>

        <hr />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm())
        {
            <div class="mb-3">

                <label>Policy Number</label>

                <input type="text"
                       name="policyNumber"
                       class="form-control"
                       placeholder="Enter Policy Number"
                       required />

            </div>

            <div class="mb-3">

                <label>New Password</label>

                <input type="password"
                       name="newPassword"
                       class="form-control"
                       required />

            </div>

            <button type="submit"
                    class="btn btn-warning w-100">
                Change Password
            </button>
        }

        <br />

        <a href="@Url.Action("Login","Account")">
            Back To Login
        </a>

    </div>

</body>
</html>