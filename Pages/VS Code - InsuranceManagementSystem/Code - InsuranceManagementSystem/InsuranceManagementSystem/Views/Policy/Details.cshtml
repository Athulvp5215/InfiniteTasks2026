@model InsuranceManagementSystem.Models.Policy

@{
    ViewBag.Title = "Policy Details";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<h2>Policy Details</h2>

<hr />

<table class="table table-bordered">

    <tr>
        <th>Policy Number</th>
        <td>@Model.PolicyNumber</td>
    </tr>

    <tr>
        <th>Plan</th>
        <td>@Model.InsurancePlan.PlanName</td>
    </tr>

    <tr>
        <th>Vehicle Number</th>
        <td>@Model.Vehicle.VehicleNumber</td>
    </tr>

    <tr>
        <th>Premium Amount</th>
        <td>₹ @Model.PremiumAmount</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.PolicyStatus</td>
    </tr>

    <tr>
        <th>Start Date</th>
        <td>@Model.StartDate</td>
    </tr>

    <tr>
        <th>End Date</th>
        <td>@Model.EndDate</td>
    </tr>

</table>

<a href="@Url.Action("MyPolicies","Policy")"
   class="btn btn-secondary">
    Back
</a>