@model InsuranceManagementSystem.Models.Payment

@{
    ViewBag.Title = "Premium Payment";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container">

    <div class="card shadow mt-4">

        <div class="card-header bg-primary text-white">

            <h3>
                Premium Payment
            </h3>

        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm())
            {

                <div class="mb-3">

                    <label class="form-label">
                        Select Policy
                    </label>

                    @Html.DropDownList(
                        "PolicyId",
                        null,
                        "Select Policy",
                        new
                        {
                            @class = "form-control",
                            required = "required"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Premium Amount
                    </label>

                    @Html.TextBoxFor(
                        m => m.Amount,
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "1",
                            required = "required",
                            placeholder = "Enter Amount"
                        })

                </div>

                <hr />

                <h5>
                    Card Details
                </h5>

                <div class="mb-3">

                    <label class="form-label">
                        Card Number
                    </label>

                    <input type="text"
                           id="CardNumber"
                           name="CardNumber"
                           class="form-control"
                           placeholder="1234567890123456"
                           maxlength="16"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Card Holder Name
                    </label>

                    <input type="text"
                           id="CardHolderName"
                           name="CardHolderName"
                           class="form-control"
                           placeholder="Enter Card Holder Name"
                           required />

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label class="form-label">
                                Expiry Month
                            </label>

                            <select id="ExpiryMonth"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select Month
                                </option>

                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">
                                        @i
                                    </option>
                                }

                            </select>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label class="form-label">
                                Expiry Year
                            </label>

                            <select id="ExpiryYear"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select Year
                                </option>

                                @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 10; i++)
                                {
                                    <option value="@i">
                                        @i
                                    </option>
                                }

                            </select>

                        </div>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        CVV
                    </label>

                    <input type="password"
                           id="CVV"
                           name="CVV"
                           class="form-control"
                           maxlength="3"
                           placeholder="123"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Pay Now

                </button>

                <a href="@Url.Action("MyPolicies","Policy")"
                   class="btn btn-secondary">

                    Cancel

                </a>

            }

        </div>

    </div>

</div>

<script>

document.querySelector("form")
.addEventListener("submit", function(e)
{
    var cardNumber =
        document.getElementById("CardNumber").value;

    var cardHolder =
        document.getElementById("CardHolderName").value;

    var cvv =
        document.getElementById("CVV").value;

    var amount =
        document.getElementById("Amount").value;

    if (!/^[0-9]{16}$/.test(cardNumber))
    {
        alert(
            "Card Number must contain exactly 16 digits");

        e.preventDefault();

        return;
    }

    if (!/^[A-Za-z ]+$/.test(cardHolder))
    {
        alert(
            "Card Holder Name should contain only letters");

        e.preventDefault();

        return;
    }

    if (!/^[0-9]{3}$/.test(cvv))
    {
        alert(
            "CVV must contain exactly 3 digits");

        e.preventDefault();

        return;
    }

    if (amount <= 0)
    {
        alert(
            "Amount must be greater than zero");

        e.preventDefault();

        return;
    }

});

</script>