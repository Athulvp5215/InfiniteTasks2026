@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      rel="stylesheet" />

<style>

    .dashboard-header {
        margin-bottom: 30px;
    }

        .dashboard-header h2 {
            font-weight: bold;
            color: #1e293b;
        }

    .stat-card {
        border: none;
        border-radius: 18px;
        padding: 25px;
        color: white;
        overflow: hidden;
        position: relative;
        transition: .3s;
        box-shadow: 0px 5px 20px rgba(0,0,0,.15);
    }

        .stat-card:hover {
            transform: translateY(-8px);
        }

        .stat-card i {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 50px;
            opacity: .25;
        }

        .stat-card h2 {
            font-size: 38px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .stat-card p {
            font-size: 18px;
            margin: 0;
        }

    .users {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .policies {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }

    .claims {
        background: linear-gradient(135deg,#f59e0b,#d97706);
    }

    .payments {
        background: linear-gradient(135deg,#dc2626,#b91c1c);
    }

    .welcome-card {
        margin-top: 35px;
        border-radius: 18px;
        border: none;
        box-shadow: 0px 5px 20px rgba(0,0,0,.12);
    }
</style>

<div class="dashboard-header">

    <h2>
        <i class="fa-solid fa-chart-line"></i>
        Admin Dashboard
    </h2>

    <p class="text-muted">
        Monitor users, policies, claims and payments.
    </p>

</div>

<div class="row g-4">

    <div class="col-md-3">

        <div class="stat-card users">

            <i class="fa-solid fa-users"></i>

            <h2>
                @ViewBag.TotalUsers
            </h2>

            <p>
                Total Users
            </p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="stat-card policies">

            <i class="fa-solid fa-file-contract"></i>

            <h2>
                @ViewBag.TotalPolicies
            </h2>

            <p>
                Total Policies
            </p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="stat-card claims">

            <i class="fa-solid fa-triangle-exclamation"></i>

            <h2>
                @ViewBag.PendingClaims
            </h2>

            <p>
                Pending Claims
            </p>

        </div>

    </div>

    <div class="col-md-3">

        <div class="stat-card payments">

            <i class="fa-solid fa-credit-card"></i>

            <h2>
                @ViewBag.TotalPayments
            </h2>

            <p>
                Total Payments
            </p>

        </div>

    </div>

</div>

<div class="card welcome-card">

    <div class="card-body">

        <h4>
            Welcome Admin
        </h4>

        <p class="text-muted">
            Manage insurance plans, users, vehicles, policies,
            claims, renewals and payments from a single dashboard.
        </p>

        <hr />

        <div class="row text-center">

            <div class="col-md-3">
                <a href="@Url.Action("Users","Admin")"
                   class="btn btn-primary w-100">
                    Manage Users
                </a>
            </div>

            <div class="col-md-3">
                <a href="@Url.Action("Policies","Admin")"
                   class="btn btn-success w-100">
                    Policies
                </a>
            </div>

            <div class="col-md-3">
                <a href="@Url.Action("Claims","Admin")"
                   class="btn btn-warning w-100">
                    Claims
                </a>
            </div>

            <div class="col-md-3">
                <a href="@Url.Action("Payments","Admin")"
                   class="btn btn-danger w-100">
                    Payments
                </a>
            </div>

        </div>

    </div>

</div>