@model InsuranceManagementSystem.Models.Renewal

@{
    ViewBag.Title = "Delete Renewal";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Delete Renewal</h2>

<div class="alert alert-danger">

    Are you sure you want to delete
    this renewal record?

</div>

<table class="table table-bordered">

    <tr>
        <th>Renewal ID</th>
        <td>@Model.RenewalId</td>
    </tr>

    <tr>
        <th>Policy Number</th>
        <td>@Model.Policy.PolicyNumber</td>
    </tr>

    <tr>
        <th>Renewal Amount</th>
        <td>₹ @Model.RenewalAmount</td>
    </tr>

</table>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.RenewalId)

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a href="@Url.Action(
        "Index",
        "Renewal")"
       class="btn btn-secondary">
        Cancel
    </a>
}