<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Insurance Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f5f5f5;
        }

        .navbar {
            background-color: #0d6efd;
        }

        .navbar-brand,
        .nav-link {
            color: white !important;
        }

        .container-box {
            background: white;
            padding: 20px;
            margin-top: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px lightgray;
        }

        footer {
            margin-top: 30px;
            text-align: center;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Dashboard","User")">
                Insurance System
            </a>

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Dashboard","User")">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("MyVehicles","Vehicle")">
                        Vehicles
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("MyPolicies","Policy")">
                        Policies
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("MyClaims","Claim")">
                        Claims
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("PaymentHistory","Payment")">
                        Payments
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Logout","Account")">
                        Logout
                    </a>
                </li>

            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="container-box">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Message"]
                </div>
            }

            @RenderBody()

        </div>
    </div>

    <footer>
        <hr />
        <p>
            © @DateTime.Now.Year Insurance Management System
        </p>
    </footer>

</body>
</html>