<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            font-family: 'Segoe UI';
        }

        .navbar {
            background: #0d6efd;
        }

        .navbar-brand,
        .nav-link {
            color: white !important;
            font-weight: bold;
        }

        .hero {
            height: 600px;
            background: linear-gradient( rgba(0,0,0,.6), rgba(0,0,0,.6)), url('https://images.unsplash.com/photo-1503376780353-7e6692767b70');
            background-size: cover;
            background-position: center;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

            .hero h1 {
                font-size: 55px;
                font-weight: bold;
            }

        .feature-box {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 0 15px lightgray;
            text-align: center;
            transition: .3s;
        }

            .feature-box:hover {
                transform: translateY(-10px);
            }

        .footer {
            background: #1e293b;
            color: white;
            padding: 25px;
            text-align: center;
            margin-top: 50px;
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index","Home")">

                Insurance System

            </a>

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index","Home")">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("About","Home")">
                        About
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Login","Account")">
                        Login
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Register","Account")">
                        Register
                    </a>
                </li>

            </ul>

        </div>

    </nav>

    @RenderBody()

    <div class="footer">

        <h5>
            Vehicle Insurance Management System
        </h5>

        <p>
            © @DateTime.Now.Year All Rights Reserved
        </p>

    </div>

</body>
</html>