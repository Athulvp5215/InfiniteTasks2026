<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="UI_Web.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>UI Web Project</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
    <form id="form1" runat="server">

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">

                <!-- Logo -->
                <span class="navbar-brand">Vehicle Insurance</span>

                <!-- Toggle (mobile) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/Home.aspx">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/BuyInsurance.aspx">Buy Insurance</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/RenewInsurance.aspx">Renew</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/ClaimInsurance.aspx">Claim</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/Estimate.aspx">Estimate</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="Pages/Login.aspx">Login</a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>

        <!-- Page Content -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

    </form>

    <!-- Bootstrap JS (for menu toggle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>