@model IEnumerable<Assessment1_Q2.Models.Movie>

<h2>All Movies</h2>

<a href="/Movies/Create">Add Movie</a>

@foreach (var m in Model)
{
    <p>
        @m.MovieName - @m.DirectorName - @m.DateOfRelease.ToShortDateString()
        |
        <a href="/Movies/Edit/@m.Mid">Edit</a>
        |
        <a href="/Movies/Delete/@m.Mid">Delete</a>
    </p>
}