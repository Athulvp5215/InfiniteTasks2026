<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Assessment1.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Food Order Management</title>
</head>
<body>
    <form runat="server">

        <div style="background-color:#4CAF50; color:white; padding:15px;">
            <h1>Food Order Management System</h1>
        </div>

      
        <div style="background-color:#f2f2f2; padding:10px;">
            <a href="MenuList.aspx">Menu Items</a> |
            <a href="AddEditMenu.aspx">Add Menu</a> |
            <a href="OrderStats.aspx">Order Stats</a> |
            <asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" />
        </div>

        <div style="padding:20px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

     
        <div style="background-color:#4CAF50; color:white; padding:10px; text-align:center;">
            © 2026 Food Order Management System
        </div>

    </form>
</body>
</html>
